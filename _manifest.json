{
  "manifest_version": 2,
  "id": "com.aurora.jmcomic-download",
  "version": "1.0.0",
  "name": "JM 漫画下载",
  "description": "把 JM 本子按章节下载并转成 PDF 发送，支持搜索与详情查询。为 MaiBot（麦麦）提供 3 个可被 LLM 自动调用的工具（jm_search / jm_detail / jm_download），并保留 /jm、/jmv、/jm搜 指令。移植自 AstrBot 插件 astrbot_plugin_comic_download（Aurora-xaa）。",
  "author": {
    "name": "Aurora-xaa",
    "url": "https://github.com/Aurora-xaa/astrbot_plugin_comic_download"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/Aurora-xaa/astrbot_plugin_comic_download"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.17.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    { "type": "python_package", "name": "jmcomic", "version_spec": ">=2.7.9" },
    { "type": "python_package", "name": "img2pdf", "version_spec": ">=0.6.0" },
    { "type": "python_package", "name": "Pillow", "version_spec": ">=9.0.0" }
  ],
  "plugin_type": "tool",
  "capabilities": [
    "send.text",
    "files.upload",
    "files.send"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
